# single-web-db — one app server + a database it migrates & seeds.
# Copy to .bedigital-visual-tests/recipe.env and fill every <...>. Then:
#   sandbox.sh doctor   # static check, fix FAILs
#   sandbox.sh onboard  # build the base image once

# The app IS the browser surface.
APP_SERVICE=app
APP_PORT="<PORT>"               # container port the app listens on (e.g. 3000/8000)

# A route that proves the app AND its DB are up (better than "/"): e.g. /healthz,
# /up (Rails), /readyz. Weaker: "/".
HEALTH_PATH="<HEALTH_PATH>"

# Hash whatever declares deps: a lockfile if present, else the manifest.
# e.g. "pnpm-lock.yaml"  |  "requirements.txt"  |  "pyproject.toml"  |  "go.mod"
LOCKFILES="<lockfile-or-manifest>"

# ---- data lifecycle ---------------------------------------------------------
DATA_SERVICES="postgres"
# Run via $COMPOSE (inside a container). `up` runs migrate then seed after the DB
# is healthy and before the app is gated; `reset` re-runs them each mission.
MIGRATE_CMD='$COMPOSE run --rm migrate'
SEED_CMD='$COMPOSE run --rm seed'
# The app holds the DB pool, so it's what `reset` restarts in place (keeps the
# ephemeral port, so SANDBOX_URL survives).
RESET_RESTART_SERVICES="app"

PLANNER_MODEL=claude-opus-4-8
DELEGATE_MODEL=claude-sonnet-5
