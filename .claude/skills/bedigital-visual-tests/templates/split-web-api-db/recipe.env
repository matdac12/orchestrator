# split-web-api-db — separate frontend + backend the browser must see as ONE
# origin (so auth cookies / CORS / build-time public API URLs work). A reverse
# proxy in front is APP_SERVICE: it routes /api -> backend, everything else ->
# frontend. Copy to .bedigital-visual-tests/recipe.env, fill every <...>, then
# `sandbox.sh doctor` and `sandbox.sh onboard`.

# The browser hits the proxy — one same-origin surface.
APP_SERVICE=proxy
APP_PORT=80

# A route the proxy sends to the BACKEND that proves app+DB are up (routed via
# the proxy's /api-or-probe match below): e.g. /readyz, /healthz, /api/health.
HEALTH_PATH="<HEALTH_PATH>"

# Hash every lockfile/manifest that affects a built image (frontend AND backend).
LOCKFILES="<frontend-lock> <backend-lock-or-manifest>"

# ---- data lifecycle ---------------------------------------------------------
DATA_SERVICES="postgres"
# The BACKEND image carries the migration/seed tooling, so it runs the seed
# (in-container `compose run`) — not the proxy, which is only the browser surface.
SEED_STRATEGY=migrations
SEED_SERVICE=backend
MIGRATE_CMD="<your migrate command>"    # e.g. alembic upgrade head / npx prisma migrate deploy
SEED_CMD="<your seed command>"          # MUST create the confirmed TEST_USER below
# The BACKEND holds the DB pool (not the proxy, the browser surface), so it's what
# `reset` restarts in place — the proxy keeps its port, so SANDBOX_URL survives.
RESET_RESTART_SERVICES="backend"

# ---- auth (fill if the app has a login) --------------------------------------
# Throwaway sandbox-only creds, safe to commit. The seed creates this user
# ALREADY CONFIRMED; delegates log in through the real form.
# TEST_USER=tester@sandbox.local
# TEST_PASSWORD=sandbox-only-pw
# LOGIN_PATH=/login
# POST_LOGIN_PATH=/

PLANNER_MODEL=claude-opus-4-8
DELEGATE_MODEL=claude-sonnet-5
