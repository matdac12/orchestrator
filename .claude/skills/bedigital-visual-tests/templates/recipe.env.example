# .bedigital-visual-tests/recipe.env — sourced by scripts/sandbox.sh.
# Commit this file. Plain KEY=VALUE only (it is `source`d by bash).

# The compose service that serves the web app the browser will hit. (required)
APP_SERVICE=frontend

# The port the app listens on INSIDE its container. (required)
# The sandbox publishes this on an ephemeral host port — never hard-code the host side.
APP_PORT=3000

# Path polled on the published port until it returns 200 before the browser drives. (default /)
HEALTH_PATH=/api/health

# Space-separated lockfile globs. Their combined hash tags the base image and
# decides when a re-onboard is needed. List EVERY lockfile that affects deps. (required)
LOCKFILES="frontend/pnpm-lock.yaml backend/uv.lock"

# OPTIONAL: an existing repo compose to layer the sanitizing override on top of.
# Leave unset for the self-contained path (Dockerfile.base + Dockerfile.sandbox).
# BASE_COMPOSE=docker-compose.yml
