# .bedigital-visual-tests/recipe.env — sourced by scripts/sandbox.sh.
# Commit this file. Plain KEY=VALUE only (it is `source`d by bash).

# The compose service that serves the web app the browser will hit. (required)
APP_SERVICE=frontend

# The port the app listens on INSIDE its container. (required)
# The sandbox publishes this on an ephemeral host port — never hard-code the host side.
APP_PORT=3000

# Path polled on the published port until it returns 200 before the browser drives. (default /)
HEALTH_PATH=/api/health

# Space-separated lockfile globs. Their combined hash tags the base image and
# decides when a re-onboard is needed. List EVERY lockfile that affects deps. (required)
LOCKFILES="frontend/pnpm-lock.yaml backend/uv.lock"

# OPTIONAL: an existing repo compose to layer the sanitizing override on top of.
# Leave unset for the self-contained path (Dockerfile.base + Dockerfile.sandbox).
# BASE_COMPOSE=docker-compose.yml

# ---- Review mode (v2 adversarial brain) -------------------------------------

# Stateful services `sandbox.sh reset` recreates between missions. (default: postgres)
# Space-separated. Only matters for review mode.
# DATA_SERVICES="postgres redis"

# ---- Data lifecycle (DB-backed apps) ----------------------------------------
# Most real apps do NOT seed from the DB image's initdb — they run migrations and
# a seed command. Define these as COMPOSE commands (they run INSIDE a container,
# never as host shell): `up` runs MIGRATE_CMD then SEED_CMD after DATA_SERVICES
# are healthy and BEFORE the app is health-gated, and `reset` re-runs them on
# every mission. $COMPOSE (full `docker compose -p <proj> -f…`) and $PROJ are
# provided. Leave both empty for a static SPA (no DB) or a self-seeding DB image.
#   MIGRATE_CMD='$COMPOSE run --rm migrate'        # or: $COMPOSE exec -T app rails db:migrate
#   SEED_CMD='$COMPOSE run --rm seed'              # or: $COMPOSE exec -T app npm run seed
# Note: with the slots set, the app must tolerate a briefly-unmigrated DB OR
# depend on the seed step in compose. The sandbox brings DATA_SERVICES up first,
# runs the slots, THEN starts the app, so a normal boot order is fine.

# Services `reset` restarts IN PLACE after reseeding, so they drop any stale DB
# pool / prepared statements. `restart` keeps the container, so the ephemeral
# SANDBOX_URL is preserved. Default: APP_SERVICE. Space-separated; empty to skip.
# RESET_RESTART_SERVICES="backend frontend"

# OPTIONAL full-override reseed for `reset` — an ESCAPE HATCH for when the default
# lifecycle (recreate DATA_SERVICES -> MIGRATE_CMD -> SEED_CMD -> restart app ->
# health) isn't enough, e.g. a DB on a NAMED volume that `rm` won't wipe. When
# set, it OWNS the reseed and MIGRATE_CMD/SEED_CMD are skipped. $COMPOSE / $PROJ
# provided. Most DB-backed apps should use MIGRATE_CMD/SEED_CMD instead.
# RESET_CMD='$COMPOSE --profile seed run --rm seed'

# Model policy for review mode. IDs are current-as-of and overridable.
# Planner (reads the diff, generates missions) = the agent running the skill —
# launch it under a strong model. Delegates (drive the browser per mission) are
# spawned as DELEGATE_MODEL subagents.
PLANNER_MODEL=claude-opus-4-8
DELEGATE_MODEL=claude-sonnet-5
