# .esegui-test/recipe.env — sourced by scripts/sandbox.sh. Commit it.
# Plain KEY=VALUE only (bash `source`s it). Throwaway values only, never real secrets.

# ---- Core (required) --------------------------------------------------------
APP_SERVICE=frontend                 # compose service serving the web app the browser hits
APP_PORT=3000                        # port inside the container; published on an ephemeral host port
LOCKFILES="frontend/pnpm-lock.yaml"  # EVERY lockfile that affects deps; their hash tags the base image

# ---- Core (optional) --------------------------------------------------------
HEALTH_PATH=/api/health              # polled until 200 before browsing (default /)
# BASE_COMPOSE=docker-compose.yml    # repo compose to layer the sanitizing override on; unset = self-contained

# Browser agent model for the missions. The planner is the session model; this only sets the delegates.
DELEGATE_MODEL=claude-haiku-5-5

# ---- Auth (apps with a login) -----------------------------------------------
# The seed creates this user ALREADY CONFIRMED; the delegate logs in via the real form.
# Throwaway and sandbox-only, so safe to commit. NEVER a real user's credentials.
# TEST_USER=tester@sandbox.local
# TEST_PASSWORD=sandbox-only-pw
# LOGIN_PATH=/login
# POST_LOGIN_PATH=/                  # where a good login lands

# ---- Seeding (apps with data) -----------------------------------------------
# SEED_STRATEGY: initdb (default: DB image's initdb only) | migrations | synthetic | snapshot (addons/snapshot)
# MIGRATE_CMD / SEED_CMD run IN-CONTAINER via `compose run` against the throwaway DB, never on the host.
# SEED_STRATEGY=migrations
# MIGRATE_CMD="npx prisma migrate deploy"
# SEED_CMD="node scripts/seed.js"

# ---- Advanced (rarely needed) -----------------------------------------------
# SEED_SERVICE=frontend              # service whose image runs the seed (default APP_SERVICE)
# DATA_SERVICES="postgres redis"     # stateful services `reset` recreates (default: postgres if defined, else none)
# RESET_RESTART_SERVICES="backend frontend"  # restarted in place after reseed (default APP_SERVICE; "" to skip)
# RESET_CMD='$COMPOSE --profile seed run --rm seed'  # full reseed override; runs via host `bash -c` (trust note)

# Supabase apps: see addons/supabase/README.md. Masked real-data snapshot: addons/snapshot/README.md.
